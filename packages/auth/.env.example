# Auth package reads host-app environment variables at runtime.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used for OAuth + email redirect URLs (never leave as localhost in production)
NEXT_PUBLIC_SITE_URL=https://vanderbase.com

# =============================================================================
# VanderBase first-party branding (required outside this repo)
# Full checklist: docs/auth/branding.md
# Email HTML: docs/auth/email-templates/
# =============================================================================
#
# Google Cloud → OAuth consent screen (Sign in with Google)
#   App name:           VanderBase
#   Support email:      hello@vanderbase.com
#   App logo:           apps/web/public/branding/vanderbase-icon-512.png
#   Home page:          https://vanderbase.com
#   Privacy / Terms:    https://vanderbase.com/privacy | /terms
#   Authorized domains: vanderbase.com
#   Redirect URI:       https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#   (Do NOT name the app after a project ref, "Supabase", or localhost.)
#
# Auth provider dashboard → URL Configuration
#   Site URL: https://vanderbase.com
#   Redirect URLs:
#     https://vanderbase.com/auth/callback
#     https://vanderbase.com/auth/callback?next=/dashboard
#     https://vanderbase.com/auth/callback?next=/verify-email
#     https://vanderbase.com/auth/callback?next=/reset-password
#     http://localhost:3000/auth/callback**   # local only
#
# Auth provider dashboard → Email Templates
#   Sender name: VanderBase
#   Subjects: "Verify your VanderBase email" / "Reset your VanderBase password"
#   Paste HTML from docs/auth/email-templates/
#   Footer: © VanderBase. All rights reserved. | hello@vanderbase.com
#
# Project Settings → Company name: VanderBase
